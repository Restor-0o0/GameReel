    <string name="fixture_destruction">Physics destruction</string>
    <string name="fixture_destruction_about">Destroying the environment is the main tool. Build challenges around what the player can take apart, break or bring down.</string>
    <string name="fixture_farming">Farming</string>
    <string name="fixture_farming_about">The player grows and harvests resources. The rhythm of tending, growth and harvest forms the core loop.</string>
    <string name="fixture_building">Building</string>
    <string name="fixture_building_about">The player creates structures. The shape and placement of buildings should affect how the game plays out.</string>
    <string name="fixture_deckbuilding">Deckbuilding</string>
    <string name="fixture_deckbuilding_about">The player assembles a deck of actions. New cards change the available combos and strategy.</string>
    <string name="fixture_stealth">Stealth</string>
    <string name="fixture_stealth_about">Observation, cover and timing matter more than direct confrontation.</string>
    <string name="fixture_inventory">Inventory management</string>
    <string name="fixture_inventory_about">Space is tight: the player decides what to take, use or leave behind. Items compete for room.</string>
    <string name="fixture_crafting">Crafting</string>
    <string name="fixture_crafting_about">Combine found resources into tools. Recipes can unlock new ways to solve problems.</string>
    <string name="fixture_logistics">Logistics</string>
    <string name="fixture_logistics_about">Delivering and distributing resources creates the tasks: where to get it, how to move it and where to send it.</string>
    <string name="fixture_repair">Repair</string>
    <string name="fixture_repair_about">Systems wear out and break. Diagnosis and repair become part of the gameplay loop.</string>
    <string name="fixture_dialogue">Dialogue choices</string>
    <string name="fixture_dialogue_about">Lines change relationships, quest conditions or available paths. Give choices visible consequences.</string>
    <string name="fixture_runs">Short runs</string>
    <string name="fixture_runs_about">Short, complete attempts with a fresh start. The player learns and tries a different mix of decisions.</string>
    <string name="fixture_sandbox">Sandbox</string>
    <string name="fixture_sandbox_about">The player sets their own goals and experiments with the systems of the world.</string>
    <string name="fixture_contracts">Contracts</string>
    <string name="fixture_contracts_about">Separate jobs with conditions and rewards. Between them the player prepares for the next one.</string>
    <string name="fixture_campaign">Campaign</string>
    <string name="fixture_campaign_about">A sequence of linked stages gradually reveals the world and raises the challenge.</string>
    <string name="fixture_days">Day cycle</string>
    <string name="fixture_days_about">Each day sets a rhythm of preparation, action and wrap-up. Conditions change the next day.</string>
    <string name="fixture_timer">Timer</string>
    <string name="fixture_timer_about">Limited time forces priorities and a choice between risk and speed.</string>
    <string name="fixture_debt">Debt</string>
    <string name="fixture_debt_about">Regular payments create pressure. The player looks for income and decides where to put the rest.</string>
    <string name="fixture_hunger">Hunger</string>
    <string name="fixture_hunger_about">Stamina needs refilling. Finding food competes with the main goal.</string>
    <string name="fixture_pursuit">Pursuit</string>
    <string name="fixture_pursuit_about">A threat is chasing the player. Stops, noise and delays can give away their position.</string>
    <string name="fixture_decay">Resource decay</string>
    <string name="fixture_decay_about">Resources spoil over time. Use them now or keep them and risk losing them?</string>
    <string name="fixture_first">First-person</string>
    <string name="fixture_first_about">The world is shown through the character’s eyes. Close interactions, scale and a limited view matter.</string>
    <string name="fixture_third">Third-person</string>
    <string name="fixture_third_about">The camera follows the character. The player sees their moves and the immediate surroundings.</string>
    <string name="fixture_top">Top-down</string>
    <string name="fixture_top_about">An overhead view helps read the space, routes and object placement.</string>
    <string name="fixture_iso">Isometric</string>
    <string name="fixture_iso_about">An angled view combines a readable layout with a sense of volume.</string>
    <string name="fixture_side">Side view</string>
    <string name="fixture_side_about">Action reads from the side. Think about verticality, silhouettes and movement along the plane.</string>
    <string name="fixture_ps1">PS1 low-poly</string>
    <string name="fixture_ps1_about">Low-poly shapes and rough textures create a retro mood.</string>
    <string name="fixture_pixel">Pixel art</string>
    <string name="fixture_pixel_about">Pixel graphics: a limited palette, expressive silhouettes and frame-by-frame animation.</string>
    <string name="fixture_voxel">Voxels</string>
    <string name="fixture_voxel_about">The world is built from volumetric blocks. Geometry can highlight taking things apart and rebuilding them.</string>
    <string name="fixture_painted">Hand-painted world</string>
    <string name="fixture_painted_about">Painted shapes and textures set the mood and underline the author’s style.</string>
    <string name="fixture_mono">Monochrome</string>
    <string name="fixture_mono_about">Limit color and work with contrast, light and silhouette.</string>
    <string name="fixture_factory">Abandoned factory</string>
    <string name="fixture_factory_about">An industrial space with machines, workshops and traces of former workers.</string>
    <string name="fixture_ocean">Underwater lab</string>
    <string name="fixture_ocean_about">An isolated lab under water: pressure, sealed hatches and the unknown outside.</string>
    <string name="fixture_space">Space station</string>
    <string name="fixture_space_about">The closed world of a station where air, power and comms need attention.</string>
    <string name="fixture_village">Forest village</string>
    <string name="fixture_village_about">A small settlement in the woods. Everyday life sits next to the secrets of nature.</string>
    <string name="fixture_train">Endless train</string>
    <string name="fixture_train_about">A moving world made of carriages. The space is linear and the journey may never end.</string>
    <string name="fixture_break">Any machine can break</string>
    <string name="fixture_break_about">Reliability is not guaranteed: any machine can fail and change the plan.</string>
    <string name="fixture_enemy">Player runs the enemy economy</string>
    <string name="fixture_enemy_about">Instead of a direct win, the player changes the enemy’s resources and incentives.</string>
    <string name="fixture_night">The world changes every night</string>
    <string name="fixture_night_about">At night the rules or the layout of the world change. Preparing during the day affects survival.</string>
    <string name="fixture_memory">Items remember their owners</string>
    <string name="fixture_memory_about">Items carry the history of their owners. The past can affect their properties and how the world treats them.</string>
    <string name="fixture_cost">Every upgrade has a price</string>
    <string name="fixture_cost_about">Boosting one ability weakens another. Every upgrade becomes a deliberate trade-off.</string>
