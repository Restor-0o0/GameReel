    <string name="fixture_destruction">Fizyczna destrukcja</string>
    <string name="fixture_destruction_about">Niszczenie otoczenia to główne narzędzie. Buduj wyzwania wokół tego, co gracz może rozebrać, rozbić lub zawalić.</string>
    <string name="fixture_farming">Uprawa</string>
    <string name="fixture_farming_about">Gracz uprawia i zbiera zasoby. Rytm doglądania, wzrostu i zbiorów tworzy główną pętlę.</string>
    <string name="fixture_building">Budowanie</string>
    <string name="fixture_building_about">Gracz tworzy konstrukcje. Kształt i rozmieszczenie budynków powinny wpływać na przebieg gry.</string>
    <string name="fixture_deckbuilding">Budowanie talii</string>
    <string name="fixture_deckbuilding_about">Gracz składa talię akcji. Nowe karty zmieniają dostępne kombinacje i strategię.</string>
    <string name="fixture_stealth">Skradanie</string>
    <string name="fixture_stealth_about">Obserwacja, osłona i wyczucie czasu liczą się bardziej niż bezpośrednia konfrontacja.</string>
    <string name="fixture_inventory">Zarządzanie ekwipunkiem</string>
    <string name="fixture_inventory_about">Miejsca jest mało: gracz decyduje, co zabrać, użyć lub zostawić. Przedmioty walczą o miejsce.</string>
    <string name="fixture_crafting">Rzemiosło</string>
    <string name="fixture_crafting_about">Łącz znalezione zasoby w narzędzia. Receptury mogą odblokować nowe sposoby rozwiązywania problemów.</string>
    <string name="fixture_logistics">Logistyka</string>
    <string name="fixture_logistics_about">Dostarczanie i rozdzielanie zasobów tworzy zadania: skąd je wziąć, jak przewieźć i dokąd wysłać.</string>
    <string name="fixture_repair">Naprawy</string>
    <string name="fixture_repair_about">Systemy się zużywają i psują. Diagnoza i naprawa stają się częścią pętli rozgrywki.</string>
    <string name="fixture_dialogue">Wybory dialogowe</string>
    <string name="fixture_dialogue_about">Kwestie zmieniają relacje, warunki zadań lub dostępne ścieżki. Daj wyborom widoczne konsekwencje.</string>
    <string name="fixture_runs">Krótkie podejścia</string>
    <string name="fixture_runs_about">Krótkie, zamknięte próby ze startem od zera. Gracz uczy się i próbuje innej kombinacji decyzji.</string>
    <string name="fixture_sandbox">Piaskownica</string>
    <string name="fixture_sandbox_about">Gracz sam wyznacza sobie cele i eksperymentuje z systemami świata.</string>
    <string name="fixture_contracts">Zlecenia</string>
    <string name="fixture_contracts_about">Osobne zadania z warunkami i nagrodami. Pomiędzy nimi gracz przygotowuje się do kolejnego.</string>
    <string name="fixture_campaign">Kampania</string>
    <string name="fixture_campaign_about">Sekwencja powiązanych etapów stopniowo odsłania świat i podnosi poprzeczkę.</string>
    <string name="fixture_days">Cykl dni</string>
    <string name="fixture_days_about">Każdy dzień wyznacza rytm przygotowań, działania i podsumowania. Warunki zmieniają się następnego dnia.</string>
    <string name="fixture_timer">Licznik czasu</string>
    <string name="fixture_timer_about">Ograniczony czas wymusza priorytety i wybór między ryzykiem a szybkością.</string>
    <string name="fixture_debt">Dług</string>
    <string name="fixture_debt_about">Regularne spłaty tworzą presję. Gracz szuka dochodu i decyduje, na co przeznaczyć resztę.</string>
    <string name="fixture_hunger">Głód</string>
    <string name="fixture_hunger_about">Wytrzymałość trzeba uzupełniać. Szukanie jedzenia konkuruje z głównym celem.</string>
    <string name="fixture_pursuit">Pościg</string>
    <string name="fixture_pursuit_about">Zagrożenie ściga gracza. Postoje, hałas i opóźnienia mogą zdradzić jego pozycję.</string>
    <string name="fixture_decay">Psucie się zasobów</string>
    <string name="fixture_decay_about">Zasoby psują się z czasem. Zużyć je teraz czy zachować, ryzykując ich utratę?</string>
    <string name="fixture_first">Pierwsza osoba</string>
    <string name="fixture_first_about">Świat widać oczami postaci. Liczą się bliskie interakcje, skala i ograniczone pole widzenia.</string>
    <string name="fixture_third">Trzecia osoba</string>
    <string name="fixture_third_about">Kamera podąża za postacią. Gracz widzi jej ruchy i najbliższe otoczenie.</string>
    <string name="fixture_top">Widok z góry</string>
    <string name="fixture_top_about">Widok z góry pomaga odczytać przestrzeń, trasy i rozmieszczenie obiektów.</string>
    <string name="fixture_iso">Izometria</string>
    <string name="fixture_iso_about">Widok pod kątem łączy czytelny układ z poczuciem głębi.</string>
    <string name="fixture_side">Widok z boku</string>
    <string name="fixture_side_about">Akcję widać z boku. Pomyśl o pionowości, sylwetkach i ruchu w płaszczyźnie.</string>
    <string name="fixture_ps1">Low-poly PS1</string>
    <string name="fixture_ps1_about">Proste bryły low-poly i surowe tekstury tworzą klimat retro.</string>
    <string name="fixture_pixel">Pixel art</string>
    <string name="fixture_pixel_about">Grafika pikselowa: ograniczona paleta, wyraziste sylwetki i animacja klatka po klatce.</string>
    <string name="fixture_voxel">Woksele</string>
    <string name="fixture_voxel_about">Świat zbudowany jest z trójwymiarowych bloków. Geometria może podkreślać rozbieranie i odbudowę.</string>
    <string name="fixture_painted">Ręcznie malowany świat</string>
    <string name="fixture_painted_about">Malowane kształty i tekstury budują nastrój i podkreślają autorski styl.</string>
    <string name="fixture_mono">Monochromia</string>
    <string name="fixture_mono_about">Ogranicz kolor i pracuj kontrastem, światłem i sylwetką.</string>
    <string name="fixture_factory">Opuszczona fabryka</string>
    <string name="fixture_factory_about">Przestrzeń przemysłowa z maszynami, warsztatami i śladami dawnych pracowników.</string>
    <string name="fixture_ocean">Podwodne laboratorium</string>
    <string name="fixture_ocean_about">Odizolowane laboratorium pod wodą: ciśnienie, szczelne włazy i nieznane za szybą.</string>
    <string name="fixture_space">Stacja kosmiczna</string>
    <string name="fixture_space_about">Zamknięty świat stacji, gdzie powietrze, zasilanie i łączność wymagają uwagi.</string>
    <string name="fixture_village">Leśna wioska</string>
    <string name="fixture_village_about">Mała osada w lesie. Codzienność sąsiaduje z tajemnicami natury.</string>
    <string name="fixture_train">Niekończący się pociąg</string>
    <string name="fixture_train_about">Ruchomy świat złożony z wagonów. Przestrzeń jest liniowa, a podróż może nigdy się nie skończyć.</string>
    <string name="fixture_break">Każda maszyna może się zepsuć</string>
    <string name="fixture_break_about">Niezawodność nie jest gwarantowana: każda maszyna może zawieść i zmienić plan.</string>
    <string name="fixture_enemy">Gracz steruje gospodarką wroga</string>
    <string name="fixture_enemy_about">Zamiast bezpośredniego zwycięstwa gracz zmienia zasoby i motywacje przeciwnika.</string>
    <string name="fixture_night">Świat zmienia się każdej nocy</string>
    <string name="fixture_night_about">Nocą zmieniają się zasady lub układ świata. Przygotowania za dnia wpływają na przetrwanie.</string>
