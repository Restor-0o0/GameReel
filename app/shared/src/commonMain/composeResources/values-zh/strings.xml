    <string name="fixture_destruction">物理破坏</string>
    <string name="fixture_destruction_about">破坏环境是主要手段。围绕玩家可以拆解、打碎或推倒的东西来设计挑战。</string>
    <string name="fixture_farming">种植</string>
    <string name="fixture_farming_about">玩家培育并收获资源。照料、生长和收获的节奏构成核心循环。</string>
    <string name="fixture_building">建造</string>
    <string name="fixture_building_about">玩家建造建筑。建筑的形状和布局应当影响玩法。</string>
    <string name="fixture_deckbuilding">卡组构筑</string>
    <string name="fixture_deckbuilding_about">玩家构筑行动卡组。新卡牌会改变可用的连招和策略。</string>
    <string name="fixture_stealth">潜行</string>
    <string name="fixture_stealth_about">观察、掩护和时机比正面冲突更重要。</string>
    <string name="fixture_inventory">背包管理</string>
    <string name="fixture_inventory_about">空间有限：玩家决定带什么、用什么、丢什么。物品之间争夺位置。</string>
    <string name="fixture_crafting">制作</string>
    <string name="fixture_crafting_about">把找到的资源组合成工具。配方可以带来解决问题的新方法。</string>
    <string name="fixture_logistics">物流</string>
    <string name="fixture_logistics_about">运送和分配资源产生任务：从哪里获取、如何运输、送往何处。</string>
    <string name="fixture_repair">维修</string>
    <string name="fixture_repair_about">系统会磨损和故障。诊断和维修成为游戏循环的一部分。</string>
    <string name="fixture_dialogue">对话选择</string>
    <string name="fixture_dialogue_about">台词会改变关系、任务条件或可走的路线。让选择产生看得见的后果。</string>
    <string name="fixture_runs">短局</string>
    <string name="fixture_runs_about">从零开始的短小完整尝试。玩家边学边试另一种决策组合。</string>
    <string name="fixture_sandbox">沙盒</string>
    <string name="fixture_sandbox_about">玩家自己设定目标，并用世界中的系统进行实验。</string>
    <string name="fixture_contracts">委托</string>
    <string name="fixture_contracts_about">带有条件和奖励的独立任务。在任务之间，玩家为下一个做准备。</string>
    <string name="fixture_campaign">战役</string>
    <string name="fixture_campaign_about">一系列相连的关卡逐步揭示世界并提高挑战。</string>
    <string name="fixture_days">昼夜循环</string>
    <string name="fixture_days_about">每一天都带来准备、行动和总结的节奏。第二天条件会改变。</string>
    <string name="fixture_timer">计时器</string>
    <string name="fixture_timer_about">有限的时间迫使玩家排定优先级，并在风险与速度之间取舍。</string>
    <string name="fixture_debt">债务</string>
    <string name="fixture_debt_about">定期还款带来压力。玩家寻找收入，并决定剩余资金的用途。</string>
    <string name="fixture_hunger">饥饿</string>
    <string name="fixture_hunger_about">体力需要补充。寻找食物会与主要目标相互竞争。</string>
    <string name="fixture_pursuit">追逐</string>
    <string name="fixture_pursuit_about">威胁在追赶玩家。停下、发出声响和拖延都可能暴露位置。</string>
    <string name="fixture_decay">资源腐坏</string>
    <string name="fixture_decay_about">资源会随时间变质。现在就用，还是冒着失去的风险留着？</string>
    <string name="fixture_first">第一人称</string>
    <string name="fixture_first_about">通过角色的眼睛展示世界。近距离互动、尺度感和有限视野很重要。</string>
    <string name="fixture_third">第三人称</string>
    <string name="fixture_third_about">镜头跟随角色。玩家能看到角色的动作和周围环境。</string>
    <string name="fixture_top">俯视视角</string>
    <string name="fixture_top_about">从上往下的视角便于读懂空间、路线和物体位置。</string>
    <string name="fixture_iso">等距视角</string>
    <string name="fixture_iso_about">斜角视角兼顾清晰的布局和立体感。</string>
    <string name="fixture_side">横版视角</string>
    <string name="fixture_side_about">从侧面呈现动作。考虑高低层次、剪影和平面上的移动。</string>
    <string name="fixture_ps1">低多边形 PS1</string>
    <string name="fixture_ps1_about">低多边形造型和粗糙纹理营造复古氛围。</string>
    <string name="fixture_pixel">像素画</string>
    <string name="fixture_pixel_about">像素图形：有限的调色板、鲜明的剪影和逐帧动画。</string>
    <string name="fixture_voxel">体素</string>
    <string name="fixture_voxel_about">世界由立体方块构成。几何结构可以突出拆解和重建。</string>
    <string name="fixture_painted">手绘世界</string>
    <string name="fixture_painted_about">手绘的形状和纹理奠定氛围，突出作者风格。</string>
    <string name="fixture_mono">单色</string>
    <string name="fixture_mono_about">限制色彩，用对比、光线和剪影来表现。</string>
    <string name="fixture_factory">废弃工厂</string>
    <string name="fixture_factory_about">一个留有机器、车间和昔日工人痕迹的工业空间。</string>
    <string name="fixture_ocean">海底实验室</string>
    <string name="fixture_ocean_about">水下孤立的实验室：水压、密封舱门，以及外面的未知。</string>
    <string name="fixture_space">空间站</string>
    <string name="fixture_space_about">一个封闭的空间站世界，空气、电力和通讯都需要照看。</string>
    <string name="fixture_village">林中村落</string>
    <string name="fixture_village_about">森林里的小聚落。日常生活与自然的秘密比邻而居。</string>
    <string name="fixture_train">无尽列车</string>
    <string name="fixture_train_about">由车厢组成的移动世界。空间是线性的，旅程可能永无尽头。</string>
    <string name="fixture_break">任何机器都可能坏</string>
    <string name="fixture_break_about">可靠性没有保证：任何机器都可能出故障并打乱计划。</string>
    <string name="fixture_enemy">玩家操控敌方经济</string>
    <string name="fixture_enemy_about">玩家不是直接取胜，而是改变对手的资源和动机。</string>
    <string name="fixture_night">世界每晚都会改变</string>
    <string name="fixture_night_about">到了夜晚，世界的规则或结构会改变。白天的准备影响生存。</string>
    <string name="fixture_memory">物品记得主人</string>
    <string name="fixture_memory_about">物品承载着主人的过往。过去会影响物品的属性，以及世界如何对待它们。</string>
    <string name="fixture_cost">每次强化都有代价</string>
    <string name="fixture_cost_about">强化一项能力会削弱另一项。每次强化都成为有意识的取舍。</string>
