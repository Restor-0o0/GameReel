    <string name="fixture_destruction">Fiziksel yıkım</string>
    <string name="fixture_destruction_about">Çevreyi yıkmak ana araçtır. Zorlukları oyuncunun söküp kırabileceği veya yıkabileceği şeylerin etrafında kur.</string>
    <string name="fixture_farming">Tarım</string>
    <string name="fixture_farming_about">Oyuncu kaynak yetiştirir ve toplar. Bakım, büyüme ve hasat ritmi ana döngüyü oluşturur.</string>
    <string name="fixture_building">İnşa</string>
    <string name="fixture_building_about">Oyuncu yapılar kurar. Binaların şekli ve yerleşimi oynanışı etkilemeli.</string>
    <string name="fixture_deckbuilding">Deste kurma</string>
    <string name="fixture_deckbuilding_about">Oyuncu bir eylem destesi kurar. Yeni kartlar kullanılabilir kombinasyonları ve stratejiyi değiştirir.</string>
    <string name="fixture_stealth">Gizlilik</string>
    <string name="fixture_stealth_about">Gözlem, siper ve zamanlama doğrudan çatışmadan daha önemlidir.</string>
    <string name="fixture_inventory">Envanter yönetimi</string>
    <string name="fixture_inventory_about">Yer kısıtlı: oyuncu neyi alacağına, kullanacağına veya bırakacağına karar verir. Eşyalar yer için yarışır.</string>
    <string name="fixture_crafting">Üretim</string>
    <string name="fixture_crafting_about">Bulunan kaynakları araçlara dönüştür. Tarifler sorunları çözmenin yeni yollarını açabilir.</string>
    <string name="fixture_logistics">Lojistik</string>
    <string name="fixture_logistics_about">Kaynakları taşımak ve dağıtmak görevleri oluşturur: nereden alınacak, nasıl taşınacak, nereye gönderilecek.</string>
    <string name="fixture_repair">Onarım</string>
    <string name="fixture_repair_about">Sistemler yıpranır ve bozulur. Teşhis ve onarım oynanış döngüsünün parçası olur.</string>
    <string name="fixture_dialogue">Diyalog seçimleri</string>
    <string name="fixture_dialogue_about">Replikler ilişkileri, görev koşullarını veya açık yolları değiştirir. Seçimlerin görünür sonuçları olsun.</string>
    <string name="fixture_runs">Kısa denemeler</string>
    <string name="fixture_runs_about">Sıfırdan başlayan kısa, eksiksiz denemeler. Oyuncu öğrenir ve farklı bir karar karışımı dener.</string>
    <string name="fixture_sandbox">Sandbox</string>
    <string name="fixture_sandbox_about">Oyuncu kendi hedeflerini belirler ve dünyanın sistemleriyle deney yapar.</string>
    <string name="fixture_contracts">Sözleşmeler</string>
    <string name="fixture_contracts_about">Koşulları ve ödülleri olan ayrı görevler. Aralarında oyuncu bir sonrakine hazırlanır.</string>
    <string name="fixture_campaign">Sefer</string>
    <string name="fixture_campaign_about">Birbirine bağlı aşamalar dünyayı yavaş yavaş açar ve zorluğu artırır.</string>
    <string name="fixture_days">Gün döngüsü</string>
    <string name="fixture_days_about">Her gün hazırlık, eylem ve değerlendirme ritmi verir. Koşullar ertesi gün değişir.</string>
    <string name="fixture_timer">Zamanlayıcı</string>
    <string name="fixture_timer_about">Kısıtlı süre öncelik belirlemeyi ve risk ile hız arasında seçim yapmayı zorunlu kılar.</string>
    <string name="fixture_debt">Borç</string>
    <string name="fixture_debt_about">Düzenli ödemeler baskı yaratır. Oyuncu gelir arar ve kalanı nereye harcayacağına karar verir.</string>
    <string name="fixture_hunger">Açlık</string>
    <string name="fixture_hunger_about">Dayanıklılık yenilenmeli. Yiyecek aramak ana hedefle yarışır.</string>
    <string name="fixture_pursuit">Kovalamaca</string>
    <string name="fixture_pursuit_about">Bir tehdit oyuncuyu kovalar. Durmak, ses ve gecikme konumunu ele verebilir.</string>
    <string name="fixture_decay">Kaynak bozulması</string>
    <string name="fixture_decay_about">Kaynaklar zamanla bozulur. Şimdi mi kullanmalı, yoksa kaybetme riskine rağmen saklamalı mı?</string>
    <string name="fixture_first">Birinci şahıs</string>
    <string name="fixture_first_about">Dünya karakterin gözünden görünür. Yakın etkileşimler, ölçek ve sınırlı görüş önemlidir.</string>
    <string name="fixture_third">Üçüncü şahıs</string>
    <string name="fixture_third_about">Kamera karakteri takip eder. Oyuncu hareketlerini ve yakın çevresini görür.</string>
    <string name="fixture_top">Yukarıdan görünüm</string>
    <string name="fixture_top_about">Yukarıdan bakış alanı, rotaları ve nesnelerin yerleşimini okumayı kolaylaştırır.</string>
    <string name="fixture_iso">İzometrik</string>
    <string name="fixture_iso_about">Açılı görünüm okunabilir bir yerleşimi hacim hissiyle birleştirir.</string>
    <string name="fixture_side">Yandan görünüm</string>
    <string name="fixture_side_about">Aksiyon yandan okunur. Dikeyliği, siluetleri ve düzlemdeki hareketi düşün.</string>
    <string name="fixture_ps1">Low-poly PS1</string>
    <string name="fixture_ps1_about">Low-poly formlar ve kaba dokular retro bir atmosfer yaratır.</string>
    <string name="fixture_pixel">Piksel sanatı</string>
    <string name="fixture_pixel_about">Piksel grafikler: sınırlı palet, belirgin siluetler ve kare kare animasyon.</string>
    <string name="fixture_voxel">Voksel</string>
    <string name="fixture_voxel_about">Dünya hacimli bloklardan oluşur. Geometri sökmeyi ve yeniden kurmayı vurgulayabilir.</string>
    <string name="fixture_painted">Elle boyanmış dünya</string>
    <string name="fixture_painted_about">Boyanmış formlar ve dokular atmosferi belirler ve kişisel üslubu öne çıkarır.</string>
    <string name="fixture_mono">Tek renkli</string>
    <string name="fixture_mono_about">Rengi sınırla; kontrast, ışık ve siluetle çalış.</string>
    <string name="fixture_factory">Terk edilmiş fabrika</string>
    <string name="fixture_factory_about">Makineler, atölyeler ve eski işçilerin izleriyle dolu endüstriyel bir alan.</string>
    <string name="fixture_ocean">Su altı laboratuvarı</string>
    <string name="fixture_ocean_about">Su altında yalıtılmış bir laboratuvar: basınç, kapalı kapaklar ve dışarıdaki bilinmeyen.</string>
    <string name="fixture_space">Uzay istasyonu</string>
    <string name="fixture_space_about">Havanın, enerjinin ve iletişimin dikkat istediği kapalı bir istasyon dünyası.</string>
    <string name="fixture_village">Orman köyü</string>
    <string name="fixture_village_about">Ormanda küçük bir yerleşim. Gündelik hayat doğanın sırlarıyla yan yana.</string>
    <string name="fixture_train">Sonsuz tren</string>
    <string name="fixture_train_about">Vagonlardan oluşan hareketli bir dünya. Alan doğrusal ve yolculuk hiç bitmeyebilir.</string>
    <string name="fixture_break">Her makine bozulabilir</string>
    <string name="fixture_break_about">Güvenilirlik garanti değil: herhangi bir makine arızalanıp planı değiştirebilir.</string>
    <string name="fixture_enemy">Oyuncu düşman ekonomisini yönetir</string>
    <string name="fixture_enemy_about">Doğrudan zafer yerine oyuncu düşmanın kaynaklarını ve teşviklerini değiştirir.</string>
    <string name="fixture_night">Dünya her gece değişir</string>
    <string name="fixture_night_about">Gece dünyanın kuralları veya yapısı değişir. Gündüz yapılan hazırlık hayatta kalmayı etkiler.</string>
