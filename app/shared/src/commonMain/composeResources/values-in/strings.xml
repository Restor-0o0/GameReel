    <string name="fixture_destruction">Kehancuran fisik</string>
    <string name="fixture_destruction_about">Menghancurkan lingkungan adalah alat utama. Bangun tantangan di sekitar apa yang bisa dibongkar, dipecahkan, atau dirobohkan pemain.</string>
    <string name="fixture_farming">Bertani</string>
    <string name="fixture_farming_about">Pemain menanam dan memanen sumber daya. Ritme merawat, tumbuh, dan panen membentuk siklus utama.</string>
    <string name="fixture_building">Membangun</string>
    <string name="fixture_building_about">Pemain membuat bangunan. Bentuk dan penempatannya harus memengaruhi permainan.</string>
    <string name="fixture_deckbuilding">Menyusun dek</string>
    <string name="fixture_deckbuilding_about">Pemain menyusun dek aksi. Kartu baru mengubah kombo dan strategi yang tersedia.</string>
    <string name="fixture_stealth">Siluman</string>
    <string name="fixture_stealth_about">Pengamatan, perlindungan, dan waktu lebih penting daripada konfrontasi langsung.</string>
    <string name="fixture_inventory">Manajemen inventaris</string>
    <string name="fixture_inventory_about">Ruang terbatas: pemain memutuskan apa yang dibawa, dipakai, atau ditinggal. Barang berebut tempat.</string>
    <string name="fixture_crafting">Kerajinan</string>
    <string name="fixture_crafting_about">Gabungkan sumber daya yang ditemukan menjadi alat. Resep dapat membuka cara baru memecahkan masalah.</string>
    <string name="fixture_logistics">Logistik</string>
    <string name="fixture_logistics_about">Mengantar dan membagikan sumber daya menciptakan tugas: dari mana mendapatkannya, cara memindahkannya, dan ke mana mengirimnya.</string>
    <string name="fixture_repair">Perbaikan</string>
    <string name="fixture_repair_about">Sistem aus dan rusak. Diagnosis dan perbaikan menjadi bagian dari siklus permainan.</string>
    <string name="fixture_dialogue">Pilihan dialog</string>
    <string name="fixture_dialogue_about">Kalimat mengubah hubungan, syarat misi, atau jalur yang tersedia. Beri pilihan konsekuensi yang terlihat.</string>
    <string name="fixture_runs">Percobaan singkat</string>
    <string name="fixture_runs_about">Percobaan singkat dan utuh yang dimulai dari nol. Pemain belajar dan mencoba campuran keputusan lain.</string>
    <string name="fixture_sandbox">Sandbox</string>
    <string name="fixture_sandbox_about">Pemain menentukan tujuannya sendiri dan bereksperimen dengan sistem dunia.</string>
    <string name="fixture_contracts">Kontrak</string>
    <string name="fixture_contracts_about">Tugas terpisah dengan syarat dan hadiah. Di antaranya, pemain bersiap untuk tugas berikutnya.</string>
    <string name="fixture_campaign">Kampanye</string>
    <string name="fixture_campaign_about">Rangkaian tahap yang saling terkait perlahan membuka dunia dan menaikkan tantangan.</string>
    <string name="fixture_days">Siklus hari</string>
    <string name="fixture_days_about">Setiap hari memberi ritme persiapan, aksi, dan evaluasi. Kondisi berubah keesokan harinya.</string>
    <string name="fixture_timer">Pengatur waktu</string>
    <string name="fixture_timer_about">Waktu terbatas memaksa pemain menentukan prioritas dan memilih antara risiko dan kecepatan.</string>
    <string name="fixture_debt">Utang</string>
    <string name="fixture_debt_about">Pembayaran rutin menciptakan tekanan. Pemain mencari penghasilan dan memutuskan ke mana sisanya dipakai.</string>
    <string name="fixture_hunger">Lapar</string>
    <string name="fixture_hunger_about">Stamina harus diisi ulang. Mencari makanan bersaing dengan tujuan utama.</string>
    <string name="fixture_pursuit">Pengejaran</string>
    <string name="fixture_pursuit_about">Sebuah ancaman memburu pemain. Berhenti, suara, dan penundaan dapat membocorkan posisinya.</string>
    <string name="fixture_decay">Sumber daya membusuk</string>
    <string name="fixture_decay_about">Sumber daya rusak seiring waktu. Pakai sekarang atau simpan dengan risiko kehilangannya?</string>
    <string name="fixture_first">Orang pertama</string>
    <string name="fixture_first_about">Dunia terlihat lewat mata karakter. Interaksi dekat, skala, dan pandangan terbatas itu penting.</string>
    <string name="fixture_third">Orang ketiga</string>
    <string name="fixture_third_about">Kamera mengikuti karakter. Pemain melihat gerakannya dan sekitarnya.</string>
    <string name="fixture_top">Tampilan atas</string>
    <string name="fixture_top_about">Tampilan dari atas membantu membaca ruang, rute, dan letak objek.</string>
    <string name="fixture_iso">Isometrik</string>
    <string name="fixture_iso_about">Tampilan bersudut memadukan tata letak yang jelas dengan kesan volume.</string>
    <string name="fixture_side">Tampilan samping</string>
    <string name="fixture_side_about">Aksi dibaca dari samping. Pikirkan ketinggian, siluet, dan gerak pada bidang.</string>
    <string name="fixture_ps1">Low-poly PS1</string>
    <string name="fixture_ps1_about">Bentuk low-poly dan tekstur kasar menciptakan suasana retro.</string>
    <string name="fixture_pixel">Pixel art</string>
    <string name="fixture_pixel_about">Grafis piksel: palet terbatas, siluet tegas, dan animasi bingkai demi bingkai.</string>
    <string name="fixture_voxel">Voxel</string>
    <string name="fixture_voxel_about">Dunia tersusun dari balok bervolume. Geometrinya bisa menonjolkan pembongkaran dan pembangunan ulang.</string>
    <string name="fixture_painted">Dunia lukisan tangan</string>
    <string name="fixture_painted_about">Bentuk dan tekstur lukisan membangun suasana dan menonjolkan gaya khas.</string>
    <string name="fixture_mono">Monokrom</string>
    <string name="fixture_mono_about">Batasi warna dan bermainlah dengan kontras, cahaya, dan siluet.</string>
    <string name="fixture_factory">Pabrik terbengkalai</string>
    <string name="fixture_factory_about">Ruang industri dengan mesin, bengkel, dan jejak para pekerja lama.</string>
    <string name="fixture_ocean">Laboratorium bawah laut</string>
    <string name="fixture_ocean_about">Laboratorium terisolasi di bawah air: tekanan, palka tertutup rapat, dan hal tak dikenal di luar sana.</string>
    <string name="fixture_space">Stasiun luar angkasa</string>
    <string name="fixture_space_about">Dunia tertutup sebuah stasiun di mana udara, daya, dan komunikasi butuh perhatian.</string>
    <string name="fixture_village">Desa hutan</string>
    <string name="fixture_village_about">Permukiman kecil di hutan. Kehidupan sehari-hari berdampingan dengan rahasia alam.</string>
    <string name="fixture_train">Kereta tanpa akhir</string>
    <string name="fixture_train_about">Dunia bergerak yang terdiri dari gerbong. Ruangnya linear dan perjalanan mungkin tak pernah usai.</string>
    <string name="fixture_break">Mesin apa pun bisa rusak</string>
    <string name="fixture_break_about">Keandalan tidak dijamin: mesin apa pun bisa gagal dan mengubah rencana.</string>
    <string name="fixture_enemy">Pemain mengatur ekonomi musuh</string>
    <string name="fixture_enemy_about">Alih-alih menang secara langsung, pemain mengubah sumber daya dan insentif lawan.</string>
    <string name="fixture_night">Dunia berubah setiap malam</string>
    <string name="fixture_night_about">Pada malam hari aturan atau struktur dunia berubah. Persiapan di siang hari memengaruhi kelangsungan hidup.</string>
    <string name="fixture_memory">Benda mengingat pemiliknya</string>
    <string name="fixture_memory_about">Benda membawa riwayat pemiliknya. Masa lalu bisa memengaruhi sifatnya dan cara dunia memperlakukannya.</string>
    <string name="fixture_cost">Setiap peningkatan ada harganya</string>
    <string name="fixture_cost_about">Memperkuat satu kemampuan melemahkan yang lain. Setiap peningkatan menjadi kompromi yang disengaja.</string>
