    <string name="fixture_destruction">物理破壊</string>
    <string name="fixture_destruction_about">環境の破壊が主な手段です。プレイヤーが分解・破壊・崩落させられるものを軸に課題を組み立てましょう。</string>
    <string name="fixture_farming">農業</string>
    <string name="fixture_farming_about">プレイヤーは資源を育てて収穫します。世話・成長・収穫のリズムが基本ループになります。</string>
    <string name="fixture_building">建築</string>
    <string name="fixture_building_about">プレイヤーが建物をつくります。建物の形と配置がゲームプレイに影響するべきです。</string>
    <string name="fixture_deckbuilding">デッキ構築</string>
    <string name="fixture_deckbuilding_about">プレイヤーは行動のデッキを組みます。新しいカードで使えるコンボや戦略が変わります。</string>
    <string name="fixture_stealth">ステルス</string>
    <string name="fixture_stealth_about">観察、遮蔽、タイミングが正面衝突よりも重要です。</string>
    <string name="fixture_inventory">インベントリ管理</string>
    <string name="fixture_inventory_about">スペースは限られています。何を持ち、使い、捨てるかをプレイヤーが決め、アイテム同士が場所を奪い合います。</string>
    <string name="fixture_crafting">クラフト</string>
    <string name="fixture_crafting_about">見つけた資源を組み合わせて道具にします。レシピが問題を解く新しい方法を開くこともあります。</string>
    <string name="fixture_logistics">物流</string>
    <string name="fixture_logistics_about">資源の配送と分配が課題を生みます。どこで手に入れ、どう運び、どこへ送るか。</string>
    <string name="fixture_repair">修理</string>
    <string name="fixture_repair_about">システムは消耗し、壊れます。診断と修理がゲームループの一部になります。</string>
    <string name="fixture_dialogue">会話の選択</string>
    <string name="fixture_dialogue_about">セリフが関係性、クエストの条件、選べる道筋を変えます。選択に目に見える結果を与えましょう。</string>
    <string name="fixture_runs">短いラン</string>
    <string name="fixture_runs_about">ゼロから始まる短く完結した挑戦。プレイヤーは学びながら別の判断の組み合わせを試します。</string>
    <string name="fixture_sandbox">サンドボックス</string>
    <string name="fixture_sandbox_about">プレイヤーが自分で目標を決め、世界のシステムで実験します。</string>
    <string name="fixture_contracts">依頼</string>
    <string name="fixture_contracts_about">条件と報酬のある独立した任務。その合間にプレイヤーは次に備えます。</string>
    <string name="fixture_campaign">キャンペーン</string>
    <string name="fixture_campaign_about">つながったステージが少しずつ世界を明かし、難しさを上げていきます。</string>
    <string name="fixture_days">日のサイクル</string>
    <string name="fixture_days_about">毎日が準備・行動・振り返りのリズムを生みます。翌日には条件が変わります。</string>
    <string name="fixture_timer">タイマー</string>
    <string name="fixture_timer_about">限られた時間が優先順位づけと、リスクか速さかの選択を迫ります。</string>
    <string name="fixture_debt">借金</string>
    <string name="fixture_debt_about">定期的な支払いがプレッシャーを生みます。プレイヤーは収入を探し、残りの使い道を決めます。</string>
    <string name="fixture_hunger">空腹</string>
    <string name="fixture_hunger_about">スタミナを回復する必要があります。食料探しが主目的と競合します。</string>
    <string name="fixture_pursuit">追跡</string>
    <string name="fixture_pursuit_about">脅威がプレイヤーを追ってきます。立ち止まる、音を立てる、もたつくと居場所がばれるかもしれません。</string>
    <string name="fixture_decay">資源の劣化</string>
    <string name="fixture_decay_about">資源は時間とともに傷みます。今使うか、失うリスクを負って取っておくか。</string>
    <string name="fixture_first">一人称</string>
    <string name="fixture_first_about">世界をキャラクターの目で見せます。近距離のやり取り、スケール感、限られた視界が重要です。</string>
    <string name="fixture_third">三人称</string>
    <string name="fixture_third_about">カメラがキャラクターを追います。プレイヤーはその動きと周囲を見られます。</string>
    <string name="fixture_top">見下ろし視点</string>
    <string name="fixture_top_about">上からの視点で空間、ルート、オブジェクトの配置が読み取りやすくなります。</string>
    <string name="fixture_iso">アイソメトリック</string>
    <string name="fixture_iso_about">斜めの視点が、読みやすいレイアウトと立体感を両立します。</string>
    <string name="fixture_side">横視点</string>
    <string name="fixture_side_about">アクションを横から見せます。高低差、シルエット、平面上の動きを考えましょう。</string>
    <string name="fixture_ps1">ローポリ PS1</string>
    <string name="fixture_ps1_about">ローポリの形と粗いテクスチャがレトロな雰囲気をつくります。</string>
    <string name="fixture_pixel">ドット絵</string>
    <string name="fixture_pixel_about">ピクセルグラフィック：限られたパレット、はっきりしたシルエット、コマ送りのアニメーション。</string>
    <string name="fixture_voxel">ボクセル</string>
    <string name="fixture_voxel_about">世界は立体のブロックでできています。形状で分解と再建を強調できます。</string>
    <string name="fixture_painted">手描きの世界</string>
    <string name="fixture_painted_about">描かれた形とテクスチャが雰囲気を決め、作家性を際立たせます。</string>
    <string name="fixture_mono">モノクロ</string>
    <string name="fixture_mono_about">色を絞り、コントラスト、光、シルエットで表現しましょう。</string>
    <string name="fixture_factory">廃工場</string>
    <string name="fixture_factory_about">機械、作業場、かつての労働者の痕跡が残る工業空間。</string>
    <string name="fixture_ocean">海底研究所</string>
    <string name="fixture_ocean_about">水中の孤立した研究所：水圧、密閉ハッチ、そして外に広がる未知。</string>
    <string name="fixture_space">宇宙ステーション</string>
    <string name="fixture_space_about">空気、電力、通信に気を配る必要がある、閉ざされたステーションの世界。</string>
    <string name="fixture_village">森の村</string>
    <string name="fixture_village_about">森の中の小さな集落。日々の暮らしと自然の秘密が隣り合っています。</string>
    <string name="fixture_train">終わらない列車</string>
